# SmartDesk AI - Environment Configuration Example

# Server & Database
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://smartdesk:smartdesk_password@localhost:5432/smartdesk_db

# Gemini AI Integration (Server-side only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-2-preview

# Security
SECRET_KEY=super_secure_random_jwt_secret_key_change_in_production
FRONTEND_ORIGIN=http://localhost:3000
